<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Orion.Abstractions</PackageId>
    <Description>The frozen spine of the Orion family of .NET libraries: fault-safe observer invocation, OpenTelemetry naming and instrumentation conventions (ActivitySource + Meter + static tag stamping), a testable clock seam, the shared options/DI convention, and the result/error vocabulary. Depend on this from any library that wants the Orion conventions; it has no Orion dependencies of its own.</Description>
    <PackageTags>orion;abstractions;opentelemetry;diagnostics;observer;clock;options;result;dotnet</PackageTags>
    <RootNamespace>Moongazing.Orion.Abstractions</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Moongazing.Orion.Abstractions.Tests" />
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
</Project>
